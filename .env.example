# ============================================================
# Comunicação Magnética — variáveis de ambiente
# Copie para .env.local (local) e configure no Vercel (produção).
# ============================================================

# Número de WhatsApp da mentoria/suporte (formato internacional, só dígitos).
# Ex.: Brasil + DDD + número -> 5511999999999
NEXT_PUBLIC_WHATSAPP=5500000000000

# --- Supabase (Project Settings -> API) ---------------------
# URL e chave pública (vão para o navegador — podem ser públicas).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_ou_publishable_key

# Chave SECRETA (service_role). SÓ no servidor. NUNCA com prefixo NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key

# --- Webhook da plataforma de venda (Kiwify/compatível) -----
# Token gerado no painel ao criar o webhook (usado para validar a assinatura).
KIWIFY_WEBHOOK_TOKEN=token_do_painel

# --- Cron de keep-alive (Vercel) ----------------------------
# Segredo que o Vercel envia no header Authorization do cron. Gere um valor aleatório.
CRON_SECRET=um_valor_aleatorio_longo
